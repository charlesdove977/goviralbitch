# Git
.git
.gitignore

# Secrets — mounted at runtime, never baked into the image
.env

# User-generated data — lives on the host, bind-mounted at runtime
data/
!data/cta-templates.json
logs/
recon/data/
recon/cache/

# Python
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/
**/node_modules/

# Databases
*.db
*.sqlite
*.sqlite3

# OAuth credentials (never commit, never copy)
scripts/client_secret.json

# Editors / OS
.vscode/
.idea/
.DS_Store
.paul/
